rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Checks if the user is authenticated and their email is verified
    function isVerifiedUser() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // PUBLIC DATA: aggregate board statistics
    // This is the only part of the database that is publicly readable
    match /metadata/boardStats {
      allow read: if true;
      // Only allow updates (not create/delete) by authenticated users
      // Restrict to only the expected counter fields
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['totalItems', 'lostCount', 'foundCount']);
    }

    // USER PROFILES
    match /users/{userId} {
      // Users can only read and write their own profile
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // USERNAME LOOKUP (for uniqueness checks)
    match /usernames/{username} {
      // Public read allowed to check if a username is taken during signup
      allow read: if true;
      // Only authenticated users can create a username reservation, and it must point to their own UID
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      // Only the owner of a username reservation can delete it
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // ITEMS COLLECTION
    match /items/{itemId} {
      // READ: Full item details require a verified student account
      allow read: if isVerifiedUser();

      // CREATE: Only verified students can post items
      allow create: if isVerifiedUser();

      // UPDATE: Only the original poster can update their item (e.g. mark as claimed)
      // We check the postedByUid field in the existing document
      allow update: if request.auth != null && request.auth.uid == resource.data.postedByUid;

      // DELETE: (Optional) only original poster can delete
      allow delete: if request.auth != null && request.auth.uid == resource.data.postedByUid;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Match any document in the 'items' collection
    match /items/{itemId} {
      // READ: Anyone can view lost/found items
      allow read: if true;

      // WRITE: Temporary open access for prototype development.
      // WARNING: This is UNSAFE for production.
      // Once Firebase Auth is implemented, this should be changed to:
      // allow write: if request.auth != null;
      allow write: if true;
    }
  }
}
